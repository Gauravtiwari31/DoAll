# HTTP port the API listens on
PORT=3000

# MongoDB connection string (docker-compose exposes Mongo on 27017)
MONGODB_URI=mongodb://localhost:27017/doall

# Secrets used to sign JWTs. Use long random strings in production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars

# Reverse proxies in front of the API (1 on Render / most hosts, 0 locally).
# Needed so rate limiting sees each user's real IP.
TRUST_PROXY=0

# Token lifetimes (vercel/ms format: 15m, 12h, 30d ...)
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Sign in with Google (optional, off when empty). See docs/google-sign-in.md.
# Client ID of the Google OAuth client of type "Web application"; the app must
# be built with the same value (DOALL_GOOGLE_WEB_CLIENT_ID).
GOOGLE_CLIENT_ID=
# That client's secret. Only "Signed up with Google?" on /account/delete uses it.
# Never commit it.
GOOGLE_CLIENT_SECRET=
