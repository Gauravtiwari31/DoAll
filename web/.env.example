# Copy to .env.local for local development. On Cloudflare Pages, set these
# under Settings → Variables and Secrets (all of them are public: they end up
# in the page).

# The DoAll API. Defaults to the hosted one; for a backend on your computer:
# VITE_API_URL=http://localhost:3000/api
VITE_API_URL=

# The server's Google OAuth client ID ("Web application" type, the same value
# as GOOGLE_CLIENT_ID on the server). Empty = no "Continue with Google".
VITE_GOOGLE_CLIENT_ID=

# Google AdSense: the publisher ID (ca-pub-...) and a display ad unit's slot
# ID. Empty = no ads (and no ads.txt).
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT=

# The app's Google Play page, for "Don't want ads? Get the app". Empty =
# "Coming soon to Google Play".
VITE_PLAY_STORE_URL=
